# Copy to .env and fill in. Never commit .env.
# Groq: generator (openai/gpt-oss-20b) and the frozen golden-set author.
GROQ_API_KEY=
# OpenAI: the LLM judge (gpt-6.1-sol).
OPENAI_API_KEY=
# NVIDIA NIM: the Phase 4 generator provider (openai/gpt-oss-20b).
NVIDIA_API_KEY=
